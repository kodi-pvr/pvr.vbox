# empty strings from id 30114 to 30599
# help info - Connection
msgctxt "#30600"
msgid "Contains settings for connecting to the VBox device from both your local network and from the internet. A local connection will be attempted first and if unsuccessful the internet settings will be used."
msgstr "Obsahuje nastavení pro připojení k zařízení VBox z místní sítě i z internetu. Nejdříve se zkusí místní připojení, a pokud se nezdaří, použijí se nastavení pro internet."

msgctxt "#30601"
msgid "The IP address or hostname of your VBox when accessed from the local network."
msgstr "IP adresa nebo název hostitele zařízení VBox při přístupu z místní sítě."

msgctxt "#30602"
msgid "The port used to connect to your VBox when accessed from the local network. Default value is `80`."
msgstr "Port používaný pro připojení k zařízení VBox při přístupu z místní sítě. Výchozí hodnota je `80`."

msgctxt "#30603"
msgid "The port used to connect to your VBox if using HTTPS when accessed from the local network. The default `0` means this is disabled and HTTP will be used instead."
msgstr "Port používaný pro připojení k zařízení VBox přes HTTPS při přístupu z místní sítě. Výchozí hodnota `0` znamená, že je tato volba vypnutá a místo ní se použije HTTP."

msgctxt "#30604"
msgid "The port used to connect to your VBox via UPnP when accessed from the local network. Default value is `55555`."
msgstr "Port používaný pro připojení k zařízení VBox přes UPnP při přístupu z místní sítě. Výchozí hodnota je `55555`."

msgctxt "#30605"
msgid "The value used (in seconds) to denote when a connection attempt has failed when accessed from the local network. Default value is `3`."
msgstr "Hodnota v sekundách určující, kdy se pokus o připojení z místní sítě považuje za neúspěšný. Výchozí hodnota je `3`."

msgctxt "#30606"
msgid "The IP address or hostname of your VBox when accessed from the internet."
msgstr "IP adresa nebo název hostitele zařízení VBox při přístupu z internetu."

msgctxt "#30607"
msgid "The port used to connect to your VBox when accessed from the internet."
msgstr "Port používaný pro připojení k zařízení VBox při přístupu z internetu."

msgctxt "#30608"
msgid "The port used to connect to your VBox if using HTTPS when accessed from the internet. The default `0` means this is disabled and HTTP will be used instead."
msgstr "Port používaný pro připojení k zařízení VBox přes HTTPS při přístupu z internetu. Výchozí hodnota `0` znamená, že je tato volba vypnutá a místo ní se použije HTTP."

msgctxt "#30609"
msgid "The port used to connect to your VBox via UPnP when accessed from the internet. Default value is `55555`."
msgstr "Port používaný pro připojení k zařízení VBox přes UPnP při přístupu z internetu. Výchozí hodnota je `55555`."

msgctxt "#30610"
msgid "The value used (in seconds) to denote when a connection attempt has failed when accessed from the internet. Default value is `10`."
msgstr "Hodnota v sekundách určující, kdy se pokus o připojení z internetu považuje za neúspěšný. Výchozí hodnota je `10`."

# empty strings from id 30611 to 30619
msgctxt "#30620"
msgid "Settings related to Channels & EPG."
msgstr "Nastavení související s kanály a EPG."

msgctxt "#30621"
msgid "Channel numbers can be set via either of the following two options: [LCN (Logical Channel Number) from backend] The channel numbers as set on the backend; [Channel index in backend] Starting from 1 number the channels as per the order they appear on the backend."
msgstr "Čísla kanálů lze nastavit jednou ze dvou možností: [LCN (logické číslo kanálu) z backendu] čísla kanálů nastavená v backendu; [Index kanálu v backendu] kanály se očíslují od 1 podle pořadí, v jakém se zobrazují v backendu."

msgctxt "#30622"
msgid "The amount of time in minutes prior to a programme start that a reminder should pop up."
msgstr "Doba v minutách před začátkem pořadu, kdy se má zobrazit upozornění."

msgctxt "#30623"
msgid "Ignore the initial EPG load. Enabled by default to prevent crash issues on LibreElec/CoreElec."
msgstr "Ignorovat počáteční načtení EPG. Ve výchozím stavu je zapnuto, aby se předešlo pádům v LibreELEC/CoreELEC."

# empty strings from id 30624 to 30639
msgctxt "#30640"
msgid "Settings related to the timeshift."
msgstr ""

msgctxt "#30641"
msgid "If enabled allows pause, rewind and fast-forward of live TV."
msgstr "Pokud je zapnuto, umožňuje pozastavení, přetáčení zpět a rychlý posun vpřed u živé TV."

msgctxt "#30642"
msgid "The path where the timeshift buffer files should be stored when timeshifting is enabled. Make sure you have a reasonable amount of disk space available since the buffer will grow indefinitely until you stop watching or switch channels."
msgstr "Cesta, kam se mají ukládat soubory vyrovnávací paměti časového posunu, když je časový posun povolen. Ujistěte se, že je k dispozici dostatek místa na disku, protože vyrovnávací paměť bude neomezeně růst, dokud sledování nezastavíte nebo nepřepnete kanál."
