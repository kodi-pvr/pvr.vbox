# empty strings from id 30114 to 30599
# help info - Connection
msgctxt "#30600"
msgid "Contains settings for connecting to the VBox device from both your local network and from the internet. A local connection will be attempted first and if unsuccessful the internet settings will be used."
msgstr "Sadrži postavke za povezivanje s VBox uređajem i s vaše lokalne mreže i s interneta. Prvo će se pokušati uspostaviti lokalna veza, a ako se ne uspije, koristit će se internet postavke."

msgctxt "#30601"
msgid "The IP address or hostname of your VBox when accessed from the local network."
msgstr "IP adresa ili naziv hosta vašeg VBoxa kada mu se pristupa iz lokalne mreže."

msgctxt "#30602"
msgid "The port used to connect to your VBox when accessed from the local network. Default value is `80`."
msgstr "Port koji se koristi za povezivanje s vašim VBoxom kada mu se pristupa s lokalne mreže. Zadana vrijednost je `80`."

msgctxt "#30603"
msgid "The port used to connect to your VBox if using HTTPS when accessed from the local network. The default `0` means this is disabled and HTTP will be used instead."
msgstr "Port koji se koristi za povezivanje s vašim VBoxom ako se koristi HTTPS prilikom pristupa s lokalne mreže. Zadana vrijednost `0` znači da je ovo onemogućeno i da će se umjesto toga koristiti HTTP."

msgctxt "#30604"
msgid "The port used to connect to your VBox via UPnP when accessed from the local network. Default value is `55555`."
msgstr "Port koji se koristi za povezivanje s vašim VBoxom putem UPnP-a kada mu se pristupa s lokalne mreže. Zadana vrijednost je `55555`."

msgctxt "#30605"
msgid "The value used (in seconds) to denote when a connection attempt has failed when accessed from the local network. Default value is `3`."
msgstr "Vrijednost koja se koristi (u sekundama) za označavanje neuspjelog pokušaja povezivanja prilikom pristupa s lokalne mreže. Zadana vrijednost je `3`."

msgctxt "#30606"
msgid "The IP address or hostname of your VBox when accessed from the internet."
msgstr "IP adresa ili naziv hosta vašeg VBoxa kada mu se pristupa s interneta."

msgctxt "#30607"
msgid "The port used to connect to your VBox when accessed from the internet."
msgstr "Port koji se koristi za povezivanje s vašim VBoxom prilikom pristupa s interneta."

msgctxt "#30608"
msgid "The port used to connect to your VBox if using HTTPS when accessed from the internet. The default `0` means this is disabled and HTTP will be used instead."
msgstr "Port koji se koristi za povezivanje s vašim VBoxom ako se koristi HTTPS prilikom pristupa s interneta. Zadana vrijednost `0` znači da je ovo onemogućeno i da će se umjesto toga koristiti HTTP."

msgctxt "#30609"
msgid "The port used to connect to your VBox via UPnP when accessed from the internet. Default value is `55555`."
msgstr "Port koji se koristi za povezivanje s vašim VBoxom putem UPnP-a kada se pristupa s interneta. Zadana vrijednost je `55555`."

msgctxt "#30610"
msgid "The value used (in seconds) to denote when a connection attempt has failed when accessed from the internet. Default value is `10`."
msgstr "Vrijednost koja se koristi (u sekundama) za označavanje neuspjelog pokušaja povezivanja prilikom pristupa s interneta. Zadana vrijednost je `10`."

# empty strings from id 30611 to 30619
msgctxt "#30620"
msgid "Settings related to Channels & EPG."
msgstr "Postavke vezane za kanale i EPG."

msgctxt "#30621"
msgid "Channel numbers can be set via either of the following two options: [LCN (Logical Channel Number) from backend] The channel numbers as set on the backend; [Channel index in backend] Starting from 1 number the channels as per the order they appear on the backend."
msgstr "Brojevi kanala mogu se postaviti putem jedne od sljedeće dvije opcije: [LCN (Logički broj kanala) iz pozadine] Brojevi kanala kako su postavljeni na pozadini; [Indeks kanala u pozadini] Počevši od 1, numerirajte kanale prema redoslijedu kojim se pojavljuju na pozadini."

msgctxt "#30622"
msgid "The amount of time in minutes prior to a programme start that a reminder should pop up."
msgstr "Vremenski period u minutama prije početka programa nakon kojeg bi se podsjetnik trebao pojaviti."

msgctxt "#30623"
msgid "Ignore the initial EPG load. Enabled by default to prevent crash issues on LibreElec/CoreElec."
msgstr "Zanemarite početno učitavanje EPG-a. Omogućeno prema zadanim postavkama kako bi se spriječili problemi s padom programa na LibreElec/CoreElec."

# empty strings from id 30624 to 30639
msgctxt "#30640"
msgid "Settings related to the timeshift."
msgstr "Postavke vezane za vremenski pomak."

msgctxt "#30641"
msgid "If enabled allows pause, rewind and fast-forward of live TV."
msgstr "Ako je omogućeno, omogućava pauziranje, premotavanje unazad i unaprijed za TV program uživo."

msgctxt "#30642"
msgid "The path where the timeshift buffer files should be stored when timeshifting is enabled. Make sure you have a reasonable amount of disk space available since the buffer will grow indefinitely until you stop watching or switch channels."
msgstr "Putanja gdje bi se trebale pohraniti datoteke međuspremnika za vremenski pomak kada je omogućen vremenski pomak. Osigurajte da imate dovoljno prostora na disku jer će međuspremnik neograničeno rasti sve dok ne prestanete gledati ili promijenite kanale."
